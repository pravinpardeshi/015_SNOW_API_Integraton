# =====================================================================
# ServiceNow Cloud – environment template
# Copy to .env and fill in your own values:  cp .env.example .env
# See README.md "ServiceNow Setup (One-Time)".
# Shell-exported SNOW_* variables take precedence over .env.
# Never commit .env (it holds secrets) – commit only this file.
# =====================================================================

# SNOW_INSTANCE
#   Base URL of your ServiceNow PDI / dev instance (no trailing slash).
#   Where to find it: the URL you use to log in, e.g. https://dev389543.service-now.com
#   Used by: app.py (DEFAULT_INSTANCE), testServiceNow.py (INSTANCE).
SNOW_INSTANCE=https://devXXXXXX.service-now.com

# SNOW_CLIENT_ID
#   OAuth Application Registry "Client ID" for this integration.
#   Where to find it: ServiceNow → System OAuth → Application Registry →
#   open your "OAuth API endpoint for external clients" record.
#   Used by: app.py (DEFAULT_CLIENT_ID), testServiceNow.py (CLIENT_ID).
SNOW_CLIENT_ID=your-client-id

# SNOW_CLIENT_SECRET
#   OAuth Application Registry "Client Secret" paired with SNOW_CLIENT_ID.
#   Where to find it: same Application Registry record (regenerate if lost).
#   Only a SHA-256 hash of this value is stored in the token cache file;
#   the secret itself is never written to disk.
#   Used by: app.py (DEFAULT_CLIENT_SECRET), testServiceNow.py (CLIENT_SECRET).
SNOW_CLIENT_SECRET=your-client-secret

# SNOW_TOKEN_FILE  (optional)
#   Path of the flat-file OAuth token cache. The backend reuses the cached
#   token while it is valid (survives restarts, shared with other local
#   ServiceNow callers) and mints a new one only when needed.
#   Default: .snow_token.json next to app.py. Relative paths resolve from
#   the app directory.
# SNOW_TOKEN_FILE=.snow_token.json

# SNOW_TOKEN_SKEW  (optional)
#   Safety margin, in seconds, before the real token expiry. The cached
#   token counts as usable only while (now + SNOW_TOKEN_SKEW) < expires_at,
#   so in-flight requests never use a token that dies mid-call.
#   Default: 60. Applies to: app.py token reuse checks.
# SNOW_TOKEN_SKEW=60
