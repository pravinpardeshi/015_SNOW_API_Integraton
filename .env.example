# =====================================================================
# ServiceNow Cloud – environment template
# Copy to .env and fill in your own values:  cp .env.example .env
# See README.md "ServiceNow Setup (One-Time)".
# Shell-exported SNOW_* variables take precedence over .env.
# Never commit .env (it holds secrets) – commit only this file.
# =====================================================================

# SNOW_INSTANCE
#   Base URL of your ServiceNow PDI / dev instance (no trailing slash).
#   Where to find it: the URL you use to log in, e.g. https://dev389543.service-now.com
#   Used by: app.py (DEFAULT_INSTANCE), testServiceNow.py (INSTANCE).
SNOW_INSTANCE=https://devXXXXXX.service-now.com

# SNOW_CLIENT_ID
#   OAuth Application Registry "Client ID" for this integration.
#   Where to find it: ServiceNow → System OAuth → Application Registry →
#   open your "OAuth API endpoint for external clients" record.
#   Used by: app.py (DEFAULT_CLIENT_ID), testServiceNow.py (CLIENT_ID).
SNOW_CLIENT_ID=your-client-id

# SNOW_CLIENT_SECRET
#   OAuth Application Registry "Client Secret" paired with SNOW_CLIENT_ID.
#   Where to find it: same Application Registry record (regenerate if lost).
#   Only a SHA-256 hash of this value is stored in the token cache file;
#   the secret itself is never written to disk.
#   Used by: app.py (DEFAULT_CLIENT_SECRET), testServiceNow.py (CLIENT_SECRET).
SNOW_CLIENT_SECRET=your-client-secret

# SNOW_TOKEN_FILE  (optional)
#   Path of the flat-file OAuth token cache. The backend reuses the cached
#   token while it is valid (survives restarts, shared with other local
#   ServiceNow callers) and mints a new one only when needed.
#   Default: .snow_token.json next to app.py. Relative paths resolve from
#   the app directory.
# SNOW_TOKEN_FILE=.snow_token.json

# SNOW_TOKEN_SKEW  (optional)
#   Safety margin, in seconds, before the real token expiry. The cached
#   token counts as usable only while (now + SNOW_TOKEN_SKEW) < expires_at,
#   so in-flight requests never use a token that dies mid-call.
#   Default: 60. Applies to: app.py token reuse checks.
# SNOW_TOKEN_SKEW=60

# SNOW_AUTH  (script + app auth mode; testServiceNow.py)
#   bearer (default): OAuth access token in the Authorization header.
#   basic:            per-request username/password, no token minted.
#   Use basic while inbound OAuth bearer validation is down — it is
#   unaffected by that outage. Requires SNOW_USERNAME/SNOW_PASSWORD.
# SNOW_AUTH=bearer

# SNOW_GRANT_TYPE  (bearer-mode token grant; testServiceNow.py)
#   password (default): resource-owner password grant — sends username +
#     password with the client id/secret. Requires SNOW_USERNAME/SNOW_PASSWORD
#     and an OAuth entity that allows the password grant.
#   client_credentials: machine-to-machine grant, client id/secret only.
# SNOW_GRANT_TYPE=password

# SNOW_USERNAME
#   Login user for the password grant and basic auth.
#   Used by: testServiceNow.py (USERNAME).
# SNOW_USERNAME=admin

# SNOW_PASSWORD
#   Password for SNOW_USERNAME. NEVER commit this file with a real value —
#   .env is git-ignored; keep the real password only in your local .env.
#   Used by: testServiceNow.py (PASSWORD).
# SNOW_PASSWORD=change-me

# SNOW_CUSTOM_TABLE
#   Custom table queried by testServiceNow.py (get_custom_records) and the
#   default table of the web UI card (app.py DEFAULT_CUSTOM_TABLE).
#   Default: u_snow_incident_table.
# SNOW_CUSTOM_TABLE=u_snow_incident_table

# RAG stack (rag_ingest.py + /api/rag/*) — all local, no API keys.
# OLLAMA_HOST: Ollama server (embeddings + chat generation).
# OLLAMA_EMBED_MODEL: must match between ingest and query (768 dims here).
# OLLAMA_CHAT_MODEL: local chat model for RCA prose (7-8b is CPU-friendly).
# RAG_CLOSED_STATUSES: comma-separated u_status values forming the corpus.
# RAG_TOP_K: default similar tickets retrieved per question.
# RAG_CHAT_TIMEOUT: seconds for one local-LLM call (CPU inference is slow).
# RAG_MAX_ITERS: ReAct loop cap for /api/rag/agent (each iteration ≈ 1 LLM call).
# CUR_RUN_LIMIT: max tickets per pipeline cycle / /api/current/run call.
# CUR_TOP_K: similar historic tickets retrieved per triage analysis.
# Open tickets = CUR_TABLE rows whose u_status is NOT in RAG_CLOSED_STATUSES.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.1:8b
# RAG_CLOSED_STATUSES=Resolved
# RAG_TOP_K=5
# RAG_CHAT_TIMEOUT=600
# RAG_MAX_ITERS=3
